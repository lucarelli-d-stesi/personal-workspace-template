#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-push — POS Privacy Safeguard
#
# Intercepts any push attempt to ensure personal data is never pushed
# to the canonical upstream template repository (danielelucarelli1980/personal-workspace).
# ==============================================================================
set -euo pipefail

REMOTE="$1"
URL="$2"
UPSTREAM_REPO="danielelucarelli1980/personal-workspace"

# If the target URL points to the public upstream template
if [[ "$URL" == *"$UPSTREAM_REPO"* ]]; then
    if [ "${POS_ALLOW_TEMPLATE_PUSH:-0}" = "1" ]; then
        # Maintainer explicitly authorized via publish-template.sh
        exit 0
    fi

    # Check commits being pushed for personal directories
    while read -r local_ref local_oid remote_ref remote_oid; do
        if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
            # Branch deletion, allow
            continue
        fi

        if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
            # New branch, diff against HEAD~1 or origin/main
            DIFF_TARGET="HEAD~1"
            git rev-parse --verify "$DIFF_TARGET" &>/dev/null || DIFF_TARGET=""
        else
            DIFF_TARGET="$remote_oid"
        fi

        if [ -n "$DIFF_TARGET" ]; then
            CHANGED_FILES=$(git diff --name-only "$DIFF_TARGET" "$local_oid" 2>/dev/null || true)
        else
            CHANGED_FILES=$(git show --name-only --format="" "$local_oid" 2>/dev/null || true)
        fi

        # Check for non-template personal files
        PERSONAL_FILES=$(echo "$CHANGED_FILES" | grep -E '^(areas/|backlog/items/|journal/|inbox/|profile/)' || true)
        
        # Filter out allowed template placeholder READMEs
        SUSPECT_FILES=$(echo "$PERSONAL_FILES" | grep -v -E '(README\.md|\.gitkeep|boundaries\.md|values\.md|style\.md|observations\.md)$' || true)

        if [ -n "$SUSPECT_FILES" ] || [ -n "$PERSONAL_FILES" ]; then
            echo ""
            echo "=================================================================="
            echo "🚨 [POS PRIVACY SAFEGUARD] PUSH BLOCCATO!"
            echo "=================================================================="
            echo "Stai tentando di inviare file personali al template pubblico:"
            echo "  Target: $URL"
            echo ""
            echo "File rilevati nel push:"
            echo "$PERSONAL_FILES" | sed 's/^/    - /'
            echo ""
            echo "Questo repository è il template pubblico di base del POS."
            echo "I tuoi dati personali e note devono rimanere nel tuo repository privato!"
            echo ""
            echo "Cosa fare:"
            echo "1. Crea un repository GitHub privato (es. tuo-utente/mio-pos)"
            echo "2. Reindirizza il remote 'origin' verso il tuo repository privato:"
            echo "   git remote set-url origin git@github.com:<tuo-utente>/<tuo-repo>.git"
            echo "3. Mantieni il template come upstream in sola lettura:"
            echo "   git remote add template https://github.com/danielelucarelli1980/personal-workspace.git"
            echo "   git remote set-url --push template NO_PUSH"
            echo "=================================================================="
            echo ""
            exit 1
        fi
    done
fi

exit 0
