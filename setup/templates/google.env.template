# =============================================================
# Google Workspace MCP — Credenziali OAuth 2.0 (Personali)
#
# Salva questo file come ~/.config/pos/google.env con permessi 600:
#   chmod 600 ~/.config/pos/google.env
#
# NON committare MAI questo file o il suo contenuto in Git!
# =============================================================

# ID Client OAuth creato su Google Cloud Console (Tipo: Desktop App)
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Segreto Client OAuth associato
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-your-client-secret"

# Email dell'account Google collegato (consigliato: evita di dover specificare l'email ad ogni tool call)
USER_GOOGLE_EMAIL="your-email@gmail.com"

# Modalità Single User (consigliato: true se usato da una singola persona)
MCP_SINGLE_USER_MODE="true"

# Servizi da abilitare (opzionale, default: tutti)
# Esempio: "gmail,calendar,drive"
WORKSPACE_MCP_TOOLS="gmail,calendar,drive"

# Modalità sola lettura (opzionale, true/false)
# Imposta a "true" se desideri impedire all'AI di inviare email o modificare file/eventi
WORKSPACE_MCP_READ_ONLY="false"
