# =============================================================
# Spaggiari ClasseViva — Credenziali di Accesso (Personali)
#
# Salva questo file come ~/.config/pos/classeviva.env con permessi 600:
#   chmod 600 ~/.config/pos/classeviva.env
#
# NON committare MAI questo file o il suo contenuto in Git!
# =============================================================

# Username o Codice Utente (es. G1234567 per Genitore, o S1234567 per Studente)
CLASSEVIVA_USERNAME="your-username"

# Password di accesso al registro elettronico Spaggiari
CLASSEVIVA_PASSWORD="your-password"

# Studente predefinito (opzionale per account Genitore)
# Se lasciato vuoto, la CLI interrogherà automaticamente tutte le figlie/studenti collegati.
# Puoi impostare il nome (es. "Giulia") o l'ID studente numerico per filtrare su una singola persona.
CLASSEVIVA_DEFAULT_STUDENT=""
